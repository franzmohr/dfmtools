citHeader("To cite dfmtools in publications use:")

# Same reference as CITATION.cff at the top level; a change belongs in both.
# Once the first release is archived on Zenodo, add the concept DOI here as a
# doi = "10.5281/zenodo.XXXXXXX" argument to bibentry() and to textVersion.

year <- sub("-.*", "", meta$Date)
note <- sprintf("R package version %s", meta$Version)

bibentry(bibtype = "Manual",
         title = "{dfmtools}: Bayesian Inference of Dynamic Factor Models",
         author = person(c("Franz", "X."), "Mohr"),
         year = year,
         note = note,
         url = "https://github.com/franzmohr/dfmtools",
         textVersion = paste0("Franz X. Mohr (",
                year,
                "). dfmtools: Bayesian Inference of Dynamic Factor Models. ",
                note, "."))
