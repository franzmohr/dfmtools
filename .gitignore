.Rproj.user
.Rhistory
.RData
.Ruserdata
inst/doc

# Compiled objects. src/core/ is vendored source, but its build products are no
# more tracked than the top level's.
*.o
*.so
*.dll
*.dylib
src/*.dSYM

# R CMD build / check output
/*.tar.gz
/*.Rcheck/
..Rcheck/

# data-raw/: the FRED-QD and Bayesian-Econometric-Methods inputs are third-party
# data this package does not redistribute. The script that turns them into
# data/bem_dfmdata.rda is tracked, because inst/COPYRIGHTS points at it as the
# record of how that object was produced.
data-raw/*
!data-raw/bem_dfmdata.R
